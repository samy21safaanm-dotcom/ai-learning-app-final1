AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Required if using temporary credentials (STS/SSO/assumed role):
AWS_SESSION_TOKEN=your_session_token_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name-here
PORT=4000

# Use Anthropic API directly (recommended, no AWS quota issues)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODELS=claude-opus-4-7,claude-opus-4-6,claude-opus-4-5-20251101
USE_ANTHROPIC_DIRECT=false

# Bedrock text models (prefer active Nova models, then optional Claude)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_IDS=us.amazon.nova-lite-v1:0,amazon.nova-pro-v1:0,us.amazon.nova-pro-v1:0,us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock image models (order matters; use only models enabled in your account)
BEDROCK_IMAGE_MODEL_IDS=amazon.titan-image-generator-v2:0,amazon.nova-canvas-v1:0

# Optional live video providers for contextual media search
# If omitted, the app automatically falls back to contextual YouTube/Vimeo search suggestions.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
VIMEO_ACCESS_TOKEN=your_vimeo_access_token_here

# Optional live stock image provider (Pexels). If omitted, fallback providers are used.
STOCK_IMAGE_API_KEY=your_pexels_api_key_here

# Optional live AI image provider endpoint. If omitted, public AI fallback image generation is used.
AI_IMAGE_API_URL=https://your-ai-image-api.example.com/generate
AI_IMAGE_API_KEY=your_ai_image_api_key_here

# Required IAM permissions (for S3/Bedrock):
# - s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
# - translate:TranslateText
# - bedrock:InvokeModel
